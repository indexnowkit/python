#!/usr/bin/env bash
# Release a package: push the python/ subtree of the workspace to indexnowkit/python and tag <short>@<version> on the
# subtree sha there (core@0.1.0, django@0.1.0). release.yml of indexnowkit/python then builds the distribution, publishes
# it to PyPI by trusted publishing (environment pypi-<short>) and creates the GitHub release from the CHANGELOG section.
#
# Usage: bin/tag <short> <version>          bin/tag core 0.1.0
# Refuses a dirty working tree, a version missing from the package CHANGELOG or different from __version__, a tag that
# already exists, or a repository without main yet (a tag in an empty repository runs no workflow — spec 19b).
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=lib/package.sh
source "$ROOT/bin/lib/package.sh"
REPO="git@github.com:indexnowkit/python.git"
short="${1:?usage: bin/tag <short> <version>}"
ver="${2:?usage: bin/tag <short> <version>}"
dist="$(dist_of "$short")"
module="$(module_of "$dist")"
tag="${short}@${ver}"
cd "$ROOT/.."
[ -d "python/packages/$dist" ] || { echo "tag: no package python/packages/$dist" >&2; exit 1; }
[[ "$ver" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "tag: version must be x.y.z, got $ver" >&2; exit 1; }
if [ -n "$(git status --porcelain)" ]; then
    echo "tag: the working tree is dirty; commit first" >&2
    exit 1
fi
grep -Eq "^## \[?${ver//./\\.}\]? — [0-9]{4}-[0-9]{2}-[0-9]{2}" "python/packages/$dist/CHANGELOG.md" || { echo "tag: python/packages/$dist/CHANGELOG.md has no section '## [$ver] — YYYY-MM-DD'" >&2; exit 1; }
grep -Eq "^__version__ = \"${ver//./\\.}\"$" "python/packages/$dist/src/$module/__init__.py" || { echo "tag: python/packages/$dist/src/$module/__init__.py does not say __version__ = \"$ver\"" >&2; exit 1; }
if git ls-remote --tags "$REPO" "refs/tags/$tag" | grep -q .; then
    echo "tag: $tag already exists on $REPO" >&2
    exit 1
fi
if ! git ls-remote --heads "$REPO" main | grep -q .; then
    echo "tag: $REPO has no main yet — push main first (the tag would land in an empty repository, where no workflow runs)" >&2
    exit 1
fi
sha="$(git subtree split --prefix=python -q)"
git push -q "$REPO" "${sha}:refs/heads/main"
git push -q "$REPO" "${sha}:refs/tags/${tag}"
echo "tagged $tag on ${sha:0:7} (indexnowkit/python); release.yml publishes $dist $ver to PyPI (environment pypi-$short)"
echo "next: bin/pypi-wait $short $ver"
