#!/usr/bin/env bash
# Run uv in the development image against the workspace (no local Python or uv needed).
# Usage: bin/uv [-v 3.11] [-C packages/indexnowkit] <uv args>   PYTHON_VERSION sets the default version (3.12).
#   bin/uv sync --all-packages          bin/uv run ruff check          bin/uv -v 3.11 lock --resolution lowest-direct
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=lib/image.sh
source "$ROOT/bin/lib/image.sh"
VER="${PYTHON_VERSION:-3.12}"
DIR="."
while :; do
    case "${1:-}" in
        -v) VER="$2"; shift 2 ;;
        -C) DIR="$2"; shift 2 ;;
        *) break ;;
    esac
done
run_in_image "$VER" "$DIR" uv "$@"
